{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx"
  },
  "include": [
    "app/**/*.tsx",
    "lib/**/*.ts",
    "main.tsx",
    "vite*.ts",
    "tests/**/*.ts",
    "playwright.config.ts",
    "components/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}